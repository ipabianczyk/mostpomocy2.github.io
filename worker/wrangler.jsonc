{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mostpomocy-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "assets": {"directory": "../dist", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "GITHUB_REPO": "mostpomocy/mostpomocy.github.io",
    "GITHUB_BRANCH": "main",
    "PUBLIC_SITE_URL": "https://mostpomocy.pl",
    "CF_ACCESS_TEAM_DOMAIN": "UZUPELNIJ.cloudflareaccess.com",
    "CF_ACCESS_AUD": "UZUPELNIJ_APPLICATION_AUD",
    "ADMIN_EMAILS": "pabigor@gmail.com"
  }
  // Po utworzeniu namespace KV dodaj:
  // ,"kv_namespaces": [{"binding":"CMS_STATE","id":"ID_NAMESPACE"}]
  // Dodaj custom domain admin.mostpomocy.pl w panelu Workers.
  // GITHUB_TOKEN dodaj jako secret: npx wrangler secret put GITHUB_TOKEN
}
