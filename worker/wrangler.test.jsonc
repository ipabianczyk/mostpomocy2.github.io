    "PUBLIC_SITE_URL": "https://mostpomocy2-test.pages.dev",
    "CF_ACCESS_TEAM_DOMAIN": "gentle-meadow-b91e.cloudflareaccess.com",
    "CF_ACCESS_AUD": "af2dc568f7dcc4c0c21448390eed68cad17703192e8360cea90e2d3c074195cf",
    "ADMIN_EMAILS": "pabigor@gmail.com"
  }
}
